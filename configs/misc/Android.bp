prebuilt_defaults {
    name: "misc_etc_defaults.exynos2100",
    vendor: true,
}

prebuilt_etc {
    name: "public.libraries.exynos2100",
    defaults: ["misc_etc_defaults.exynos2100"],
    src: "public.libraries.txt",
    filename: "public.libraries.txt",
}

prebuilt_etc {
    name: "sehradiomanager.conf.exynos2100",
    defaults: ["misc_etc_defaults.exynos2100"],
    src: "sehradiomanager.conf",
    filename: "sehradiomanager.conf",
}

prebuilt_etc {
    name: "thermal_info_config.exynos2100",
    defaults: ["misc_etc_defaults.exynos2100"],
    src: "thermal_info_config.json",
    filename: "thermal_info_config.json",
}
