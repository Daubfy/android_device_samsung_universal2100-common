prebuilt_defaults {
    name: "power_etc_defaults.exynos2100",
    vendor: true,
}

prebuilt_etc {
    name: "powerhint.json.exynos2100",
    defaults: ["power_etc_defaults.exynos2100"],
    src: "powerhint.json",
    filename: "powerhint.json",
}

prebuilt_etc {
    name: "task_profiles.json.exynos2100",
    defaults: ["power_etc_defaults.exynos2100"],
    src: "task_profiles.json",
    filename: "task_profiles.json",
}
