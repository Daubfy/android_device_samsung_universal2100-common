cc_library_shared {
    name: "sound_trigger.primary.exynos2100",
    relative_install_path: "hw",
    proprietary: true,
    // Hardcoded for exynos2100
    cflags: [
        "-DMMAP_INTERFACE_ENABLED",
        "-DSTHAL_2_3",
        "-DTARGET_EXYNOS2100",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libtinyalsa",
        "libhardware",
    ],
    header_libs: ["libhardware_headers"],
    include_dirs: [
        "external/tinyalsa/include",
        "device/samsung/universal2100-common/soundtrigger/conf",
    ],
    srcs: ["sound_trigger_hw.c"],
}
